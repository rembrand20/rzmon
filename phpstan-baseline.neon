parameters:
	ignoreErrors:
		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 1
			path: cron/run.php

		-
			message: '#^Comparison operation "\<" between 0 and 50 is always true\.$#'
			identifier: smaller.alwaysTrue
			count: 1
			path: public/api.php

		-
			message: '#^Offset ''ok'' on array\{ok\: bool, error\?\: string\|null, receipt\?\: string\|null\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: public/api.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: public/api.php

		-
			message: '#^Call to function method_exists\(\) with ''ZipArchive'' and ''setEncryptionName'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Backup.php

		-
			message: '#^Offset ''busy'' on array\{ok\: bool, file\: string\|null, size\: int, error\: string\|null\} in empty\(\) does not exist\.$#'
			identifier: empty.offset
			count: 1
			path: src/Backup.php

		-
			message: '#^Offset ''encryption_method'' on array\{name\: string, index\: int, crc\: int, size\: int, mtime\: int, comp_size\: int, comp_method\: int, encryption_method\: int\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 2
			path: src/Backup.php

		-
			message: '#^Offset mixed on array\{\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 5
			path: src/Chain.php

		-
			message: '#^Offset non\-falsy\-string does not exist on array\{\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Chain.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 3
			path: src/Checks.php

		-
			message: '#^Empty array passed to foreach\.$#'
			identifier: foreach.emptyArray
			count: 1
			path: src/Exceptions.php

		-
			message: '#^Match arm comparison between ''port'' and ''port'' is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: src/Exceptions.php

		-
			message: '#^Offset ''last'' does not exist on array\{hits\: \(float\|int\), n\: \(float\|int\), hosts\: non\-empty\-array\<int, mixed\>\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Exceptions.php

		-
			message: '#^Offset ''n'' does not exist on array\{hits\: \(float\|int\)\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: src/Exceptions.php

		-
			message: '#^Comparison operation "\>\=" between int\<0, max\> and 0 is always true\.$#'
			identifier: greaterOrEqual.alwaysTrue
			count: 1
			path: src/Hardening.php

		-
			message: '#^Method Heartbeat\:\:parseCron\(\) never returns array\<int, array\<int, true\>\> so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/Heartbeat.php

		-
			message: '#^Method Heartbeat\:\:parseCron\(\) should return array\<int, array\<int, true\>\>\|null but returns non\-empty\-array\<0\|1\|2\|3\|4\|''dom_any''\|''dow_any'', array\<int\<0, 59\>, true\>\|bool\>\.$#'
			identifier: return.type
			count: 1
			path: src/Heartbeat.php

		-
			message: '#^Strict comparison using \!\=\= between numeric\-string and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/Heartbeat.php

		-
			message: '#^Method IdsAdvice\:\:rdap\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/IdsAdvice.php

		-
			message: '#^Offset 0 on non\-empty\-list\<string\> on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 3
			path: src/IdsAdvice.php

		-
			message: '#^Comparison operation "\<" between 0 and 1000 is always true\.$#'
			identifier: smaller.alwaysTrue
			count: 1
			path: src/IpIntel.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: src/IpIntel.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: src/IpIntel.php

		-
			message: '#^Empty array passed to foreach\.$#'
			identifier: foreach.emptyArray
			count: 1
			path: src/NetLinks.php

		-
			message: '#^Left side of \|\| is always false\.$#'
			identifier: booleanOr.leftAlwaysFalse
			count: 1
			path: src/NetLinks.php

		-
			message: '#^Offset ''blocked'' on array\{n\: \(float\|int\)\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/NetLinks.php

		-
			message: '#^Offset ''last'' on array\{n\: \(float\|int\), blocked\: bool\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/NetLinks.php

		-
			message: '#^Offset 1 on array\{401\|403, string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/NetLinks.php

		-
			message: '#^Parameter &\$o by\-ref type of method Passkey\:\:cbor\(\) expects int, \(float\|int\) given\.$#'
			identifier: parameterByRef.type
			count: 1
			path: src/Passkey.php

		-
			message: '#^Method SessionStore\:\:gc\(\) never returns false so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/SessionStore.php

		-
			message: '#^Method SessionStore\:\:read\(\) never returns false so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: src/SessionStore.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: src/Setup.php

		-
			message: '#^Strict comparison using \!\=\= between non\-falsy\-string and '''' will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/SnmpMonitor.php

		-
			message: '#^Strict comparison using \=\=\= between 0 and 0 will always evaluate to true\.$#'
			identifier: identical.alwaysTrue
			count: 1
			path: src/SnmpMonitor.php

		-
			message: '#^Left side of \|\| is always false\.$#'
			identifier: booleanOr.leftAlwaysFalse
			count: 1
			path: src/ThreatIntel.php

		-
			message: '#^Static property ThreatIntel\:\:\$mem is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/ThreatIntel.php

		-
			message: '#^Offset 2 on array\{non\-falsy\-string, non\-falsy\-string, string, string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Updater.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: src/bootstrap.php
