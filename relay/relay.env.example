# RzSense Relay (1.282.0): kopieer naar /etc/rzsense/relay.env (quadlet) of naast compose.yaml als .env,
# en zet de rechten op alleen root: sudo chmod 600 /etc/rzsense/relay.env
# Het installatiecommando in RzSense (Beheer → Verbindingen → Netwerken en relays → ＋ Relay) vult dit voor je in.

# Adres van RzSense, zoals deze relay het bereikt: via internet (SWAG), een VPN of een eigen route
MONITOR_URL=https://rzsense.voorbeeld.nl
# Optioneel: een tweede adres, als het eerste niet werkt (bijvoorbeeld het VPN-adres)
MONITOR_URL_FALLBACK=
# Koppelcode uit RzSense (eenmalig, 15 minuten geldig). Na het koppelen mag je hem weghalen.
PAIR_CODE=
# Alleen als RzSense een eigen certificaat heeft: de vingerafdruk (staat in het installatiecommando)
PIN=
# Poort waarop de agents in dit netwerk de relay bereiken
RELAY_PORT=8444
TZ=Europe/Amsterdam
