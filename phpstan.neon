# PHPStan (1.143.0): statische controle van de PHP-code in GitHub Actions (niveau 0: echte fouten, zoals
# onbekende functies, klassen en variabelen). Lokaal: php phpstan.phar analyse --memory-limit=1G
parameters:
    level: 0
    paths:
        - src
        - public
        - cron
        - install
        - tools
    excludePaths:
        - public/assets
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
