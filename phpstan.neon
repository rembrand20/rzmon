# PHPStan: statische controle van de PHP-code in GitHub Actions (workflow Beveiliging). Niveau 4 sinds 1.145.0.
# Wat er al was staat in phpstan-baseline.neon: alleen NIEUWE meldingen maken CI rood. Iets uit de baseline opgelost?
# Maak hem opnieuw met de workflow "PHPStan-baseline maken" (anders meldt PHPStan dat een regel niet meer nodig is).
# Lokaal: php phpstan.phar analyse --memory-limit=1G
includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
        - public
        - cron
        - install
        - tools
    excludePaths:
        - public/assets
    bootstrapFiles:
        - tools/phpstan-bootstrap.php
