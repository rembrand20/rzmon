# RzSense in een container (1.281.0): kopieer naar /etc/rzsense/rzsense.env (quadlets) of naast compose.yaml als .env,
# vul de wachtwoorden in en zet de rechten op alleen root: sudo chmod 600 /etc/rzsense/rzsense.env
# Kies lange, willekeurige wachtwoorden, bijvoorbeeld met: openssl rand -base64 24

# --- MariaDB (container rzsense-db) ---
MARIADB_DATABASE=rzmon
MARIADB_USER=rzmon
MARIADB_PASSWORD=VERANDER_MIJ_database
MARIADB_ROOT_PASSWORD=VERANDER_MIJ_root

# --- RzSense ---
RZMON_DB_HOST=127.0.0.1
RZMON_DB_PORT=3306
RZMON_DB_NAME=rzmon
RZMON_DB_USER=rzmon
# Hetzelfde als MARIADB_PASSWORD hierboven (alleen bij de eerste start gebruikt; daarna staat het in config.php in het datavolume)
RZMON_DB_PASS=VERANDER_MIJ_database
# Eerste beheerder (alleen bij de eerste start). Leeg = RzSense maakt een wachtwoord en zet het in de log (podman logs rzsense).
RZMON_ADMIN_USER=admin
RZMON_ADMIN_PASS=
TZ=Europe/Amsterdam
# Optioneel: het adres van RzSense achter je reverse proxy (bv. https://rzsense.voorbeeld.nl)
RZMON_BASE_URL=
# Poorten (host-netwerk): web voor de reverse proxy, en de nooddeur (https met eigen certificaat)
RZMON_WEB_PORT=8080
RZMON_DOOR_PORT=8443
